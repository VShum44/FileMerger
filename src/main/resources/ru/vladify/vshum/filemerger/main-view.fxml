<?xml version="1.0" encoding="UTF-8"?>

<!-- Корневой контейнер -->
<!-- fx:controller — указываем какой класс управляет этим окном -->

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<VBox prefHeight="500" prefWidth="700" spacing="10" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.vladify.vshum.filemerger.controller.MainController">

    <padding>
        <Insets bottom="15" left="15" right="15" top="15"/>
    </padding>

    <HBox spacing="8.0">
        <!--  Заголовок -->
        <Label fx:id="titleLabel" styleClass="title-label" text="File Merger v1.2"/>
        <!-- Пружина — занимает всё свободное место -->
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="aboutButton"
                styleClass="icon-button"
                onAction="#onAbout">
            <tooltip>
                <Tooltip text="О программе"/>
            </tooltip>
            <graphic>
                <ImageView fitWidth="18" fitHeight="18"
                           preserveRatio="true">
                    <image>
                        <Image url="@icons/info.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <!-- Кнопка темы прижата вправо -->
        <Button fx:id="themeButton"
                onAction="#onToggleTheme"
                styleClass="icon-button">
            <tooltip>
                <Tooltip text="Переключить тему"/>
            </tooltip>
            <graphic>
                <ImageView fx:id="themeIcon" fitWidth="18" fitHeight="18"
                           preserveRatio="true"/>
            </graphic>
        </Button>
    </HBox>


    <!-- TODO: добавить выбор папки добавления файлов и сохранения по умолчанию, настройку расширения из UI -->

    <VBox spacing="8">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <!-- Поиск растягивается -->
            <TextField fx:id="searchField" promptText="Поиск по названию..." HBox.hgrow="ALWAYS"/>

            <!-- ProgressBar той же высоты, прижат вправо -->
            <ProgressBar fx:id="progressBar"
                         prefWidth="200.0"
                         prefHeight="28.0"
                         progress="0.0"
                         visible="false"
                         maxHeight="Infinity"/>
        </HBox>

        <SplitPane dividerPositions="0.7" VBox.vgrow="ALWAYS">
            <!--  Место для списка файлов -->
            <ListView fx:id="fileListView" onDragDropped="#onDragDropped" onDragEntered="#onDragEntered"
                      onDragExited="#onDragExited" onDragOver="#onDragOver" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="Перетащите файлы сюда или нажмите 'Добавить'"/>
                </placeholder>
            </ListView>
            <!--  Место для просмотра содержимого файлов -->
            <TextArea fx:id="previewArea" editable="false" promptText="Выберите элемент" wrapText="true"/>
        </SplitPane>


    </VBox>

    <!-- 3. Кнопки -->
    <HBox spacing="8">
        <Button onAction="#onAddFiles" text="Добавить">
            <tooltip>
                <Tooltip text="Добавить файлы (Ctrl+O)"/>
            </tooltip>
        </Button>

        <Button onAction="#onMoveUp" text="▲">
            <tooltip>
                <Tooltip text="Переместить вверх"/>
            </tooltip>
        </Button>

        <Button onAction="#onMoveDown" text="▼">
            <tooltip>
                <Tooltip text="Переместить вниз"/>
            </tooltip>
        </Button>

        <Button fx:id="removeButton" onAction="#onRemove" styleClass="button-danger" text="Удалить">
            <tooltip>
                <Tooltip text="Удалить выбранные (Delete). Ctrl+Click — выбрать несколько"/>
            </tooltip>
        </Button>

        <Button onAction="#onClear" styleClass="button-danger" text="Очистить">
            <tooltip>
                <Tooltip text="Очистить список"/>
            </tooltip>
        </Button>

        <Button fx:id="mergeButton" onAction="#onMerge" styleClass="button-primary" text="Склеить">
            <tooltip>
                <Tooltip text="Склеить и сохранить (Ctrl+S)"/>
            </tooltip>
        </Button>

        <ComboBox fx:id="sortComboBox" onAction="#onSortChanged">
            <tooltip>
                <Tooltip text="Сортировка списка"/>
            </tooltip>
        </ComboBox>
    </HBox>

    <!-- 4. Статус внизу -->
    <Label fx:id="statusLabel" text="Статус: готов"/>


</VBox>
