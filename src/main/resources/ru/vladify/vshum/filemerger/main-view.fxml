<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Корневой контейнер -->
<!-- fx:controller — указываем какой класс управляет этим окном -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ru.vladify.vshum.filemerger.controller.MainController"
      spacing="10"
      prefWidth="700"
      prefHeight="500">

    <!-- Элементы интерфейса -->
    <Label text="File Merger v1.0"/>

    <Label fx:id="statusLabel" text="Статус: готов"/>

    <HBox spacing="8">
        <Button text="Добавить" onAction="#onAddFiles"/>
        <Button text="Очистить" onAction="#onClear"/>
        <Button text="Склеить"  onAction="#onMerge"/>
    </HBox>

</VBox>
